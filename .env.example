# Copy to .env (gitignored). One app password per account in accounts.yaml:
# MAILMCP_PASSWORD_<ID>, id upper-cased, dashes become underscores.
# `pnpm dev` loads .env; in production the same variables come from the deploy's env file.
MAILMCP_PASSWORD_PERSONAL=
MAILMCP_PASSWORD_WORK=
# MAILMCP_DEBUG=1 prints the IMAP/SMTP protocol, mail content included. Local debugging only.
MAILMCP_DEBUG=0
