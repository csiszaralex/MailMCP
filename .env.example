# Copy to .env (gitignored). One app password per account in accounts.yaml:
# MAILMCP_PASSWORD_<ID>, id upper-cased, dashes become underscores.
# `pnpm dev` and `pnpm cli` load .env; in production the same variables come from the deploy's env file.
MAILMCP_PASSWORD_PERSONAL=
MAILMCP_PASSWORD_WORK=

# The server's public address, without a path. http only on 127.0.0.1 or localhost.
MAILMCP_PUBLIC_URL=http://127.0.0.1:8787
# Sign-in password hash: the output of `pnpm cli hash-password`.
MAILMCP_ADMIN_PASSWORD_HASH=
# TOTP secret: the first line of `pnpm cli totp-setup`.
MAILMCP_TOTP_SECRET=

# MAILMCP_DEBUG=1 prints the IMAP/SMTP protocol, mail content included. It only starts when
# MAILMCP_PUBLIC_URL and MAILMCP_HOST are both loopback. Local debugging only.
MAILMCP_DEBUG=0

# Optional, with their defaults:
# MAILMCP_HOST=127.0.0.1
# MAILMCP_PORT=8787
# MAILMCP_DATA_DIR=./data
# MAILMCP_BEHIND_PROXY=0
# MAILMCP_ACCOUNTS_FILE=accounts.yaml
